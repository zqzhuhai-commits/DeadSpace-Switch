set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT DEFINED ENV{DEVKITPRO})
  message(FATAL_ERROR "Set DEVKITPRO")
endif()
set(DKP "$ENV{DEVKITPRO}")
set(HOST_EXECUTABLE_SUFFIX "")
if(CMAKE_HOST_WIN32)
  set(HOST_EXECUTABLE_SUFFIX ".exe")
endif()
set(CMAKE_C_COMPILER "${DKP}/devkitA64/bin/aarch64-none-elf-gcc${HOST_EXECUTABLE_SUFFIX}")
set(CMAKE_CXX_COMPILER "${DKP}/devkitA64/bin/aarch64-none-elf-g++${HOST_EXECUTABLE_SUFFIX}")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(SWITCH_FLAGS "-march=armv8-a+crc+crypto -mtune=cortex-a57 -mtp=soft -ftls-model=local-exec -fPIC -D__SWITCH__ -isystem ${DKP}/libnx/include")
set(CMAKE_C_FLAGS_INIT "${SWITCH_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${SWITCH_FLAGS}")
set(CMAKE_ASM_FLAGS_INIT "${SWITCH_FLAGS}")
