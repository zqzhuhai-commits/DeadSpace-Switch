 #elif defined(__APPLE__)
@@ -28,7 +31,10 @@
     explicit CodeBlock(std::size_t size)
         : m_size(size)
     {
-#if defined(_WIN32)
+#if defined(__SWITCH__)
+        if (R_FAILED(jitCreate(&m_jit, size))) throw std::runtime_error("Switch JIT allocation unavailable");
+        m_memory = static_cast<std::uint32_t*>(jitGetRxAddr(&m_jit));
+#elif defined(_WIN32)
         m_memory = (std::uint32_t*)VirtualAlloc(nullptr, size, MEM_COMMIT, PAGE_EXECUTE_READWRITE);
 #elif defined(__APPLE__)
 #    if TARGET_OS_IPHONE
@@ -53,7 +59,9 @@
         if (m_memory == nullptr)
             return;
 
-#if defined(_WIN32)
+#if defined(__SWITCH__)
+        jitClose(&m_jit);
+#elif defined(_WIN32)
         VirtualFree((void*)m_memory, 0, MEM_RELEASE);
 #else
         munmap(m_memory, m_size);
@@ -70,9 +78,25 @@
         return m_memory;
     }
 
+    std::uint32_t* wptr() const
+    {
+#if defined(__SWITCH__)
+        return static_cast<std::uint32_t*>(jitGetRwAddr(&m_jit));
+#else
+        return m_memory;
+#endif
+    }
+
     void protect()
     {
-#if defined(__APPLE__) && !TARGET_OS_IPHONE
+#if defined(__SWITCH__)
+        if (m_jit.type == JitType_CodeMemory) {
+            // RW/RX aliases already exist. invalidate synchronizes changed ranges.
+            m_jit.is_executable = true;
+        } else if (R_FAILED(jitTransitionToExecutable(&m_jit))) {
+            throw std::runtime_error("Switch JIT executable transition failed");
+        }
+#elif defined(__APPLE__) && !TARGET_OS_IPHONE
         pthread_jit_write_protect_np(1);
 #elif defined(__APPLE__) || defined(__NetBSD__) || defined(__OpenBSD__)
         mprotect(m_memory, m_size, PROT_READ | PROT_EXEC);
@@ -81,7 +105,9 @@
 
     void unprotect()
     {
-#if defined(__APPLE__) && !TARGET_OS_IPHONE
+#if defined(__SWITCH__)
+        if (R_FAILED(jitTransitionToWritable(&m_jit))) throw std::runtime_error("Switch JIT writable transition failed");
+#elif defined(__APPLE__) && !TARGET_OS_IPHONE
         pthread_jit_write_protect_np(0);
 #elif defined(__APPLE__) || defined(__NetBSD__) || defined(__OpenBSD__)
         mprotect(m_memory, m_size, PROT_READ | PROT_WRITE);
@@ -90,7 +116,17 @@
 
     void invalidate(std::uint32_t* mem, std::size_t size)
     {
-#if defined(__APPLE__)
+#if defined(__SWITCH__)
+        const auto address = reinterpret_cast<std::uintptr_t>(mem);
+        const auto base = reinterpret_cast<std::uintptr_t>(m_memory);
+        if (address < base || address - base > m_size || size > m_size - (address - base))
+            throw std::runtime_error("Switch JIT cache range outside buffer");
+        if (size && m_jit.type == JitType_CodeMemory) {
+            armDCacheFlush(static_cast<std::uint8_t*>(jitGetRwAddr(&m_jit)) + (address - base), size);
+            armICacheInvalidate(mem, size);
+        }
+        // The legacy permission-based path synchronizes when remapped.
+#elif defined(__APPLE__)
         sys_icache_invalidate(mem, size);
 #elif defined(_WIN32)
         FlushInstructionCache(GetCurrentProcess(), mem, size);
@@ -136,6 +172,9 @@
     }
 
 protected:
+#if defined(__SWITCH__)
+    mutable Jit m_jit{};
+#endif
     std::uint32_t* m_memory;
     std::size_t m_size = 0;
 };
